{
  "expo": {
    "name": "RF Canvas",
    "slug": "rf-canvas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rfcanvas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rfcanvas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture photos and videos for your designs",
        "NSPhotoLibraryUsageDescription": "Place your photos into designs and edits",
        "NSMicrophoneUsageDescription": "Record sound with videos for your projects",
        "NSPhotoLibraryAddUsageDescription": "Save your exported designs to Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "package": "com.rfcanvas.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "RF Canvas",
      "shortName": "RF Canvas",
      "themeColor": "#FF5E00",
      "backgroundColor": "#F5F6F8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F1013"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      "expo-video",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Save your exported designs to Photos",
          "savePhotosPermission": "Save your exported designs to Photos",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F5F6F8"
  }
}
